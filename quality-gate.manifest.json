{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "CRI Common",
      "component": "ipv-cri-oauth-common",
      "promotionType": "library",
      "checks": [
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-pre-commit.yml",
            "path": "$.jobs.pre-commit"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-unit-tests.yml",
            "path": "$.jobs.run-unit-tests"
          }
        },
        {
          "checkTypes": [
            "contract"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-contract-tests.yml",
            "path": "$.jobs.run-contract-tests"
          }
        },
        {
          "checkTypes": [
            "integration",
            "regression",
            "new feature"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-workflow.yml",
            "path": "$.jobs.integration-tests"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-sonarcloud.yml",
            "path": "$.jobs.sonarcloud"
          }
        },
        {
          "checkTypes": [
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-codeql.yml",
            "path": "$.jobs.codeql"
          }
        }
      ]
    }
  ]
}
