{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "CRI Common",
      "component": "ipv-cri-oauth-common",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-pre-commit.yml",
            "path": "$.jobs.pre-commit"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-unit-tests.yml",
            "path": "$.jobs.run-unit-tests"
          },
          "checks": [
            {
              "name": "unit"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-contract-tests.yml",
            "path": "$.jobs.run-contract-tests"
          },
          "checks": [
            {
              "name": "contract"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-workflow.yml",
            "path": "$.jobs.integration-tests"
          },
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression",
                "new feature"
              ]
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-sonarcloud.yml",
            "path": "$.jobs.sonarcloud"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/run-codeql.yml",
            "path": "$.jobs.codeql"
          },
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ]
        }
      ]
    }
  ]
}
